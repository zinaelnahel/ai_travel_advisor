{
  "name": "SafarAI (Python 3.12)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    },
    "codespaces": {
      "openFiles": [
        "README.md",
        "safarai/advisor.py"
      ]
    }
  },
  "postCreateCommand": "python -m pip install -r requirements-dev.txt",
  "postAttachCommand": {
    "server": "python -m uvicorn web.app:app --host 0.0.0.0 --port 8000"
  },
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "SafarAI",
      "onAutoForward": "openPreview"
    }
  }
}
