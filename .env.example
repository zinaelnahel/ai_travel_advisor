OPENAI_API_KEY=your-key-here
# Set a password before sharing a hosted deployment; all visitors use this password.
APP_PASSWORD=
CONVERSATION_BUDGET_USD=1.0
# Research venue prices/locations through OpenAI web search. Set 0 to disable.
# Uses the same OPENAI_API_KEY; search and token charges count toward the budget.
WEB_SEARCH_ENABLED=1
# Required for stateless API tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
STATE_SIGNING_SECRET=
