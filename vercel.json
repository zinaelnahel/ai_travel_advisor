{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "python",
      "framework": "fastapi",
      "entrypoint": "app:app",
      "functions": {"app.py": {"maxDuration": 300}}
    }
  },
  "rewrites": [
    {"source": "/(.*)", "destination": {"service": "app"}}
  ]
}
